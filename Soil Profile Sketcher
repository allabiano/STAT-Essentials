# --- Define Server ---
server <- function(input, output) {
  
  pedon_data <- reactive({
    req(input$file1)
    
    inFile <- input$file1
    
    df <- read.csv(inFile$datapath,
                   header = input$header,
                   sep = input$sep,
                   quote = input$quote,
                   stringsAsFactors = FALSE)
    
    # Automatically standardize input header names
    df <- standardize_columns(df)
    
    # Required columns target
    required_cols <- c("Profile", "top", "bottom",
                       "Hue", "Value", "Chroma", "Horizon.Name")
    
    # User-friendly validation error if columns are missing
    missing_cols <- setdiff(required_cols, names(df))
    validate(
      need(length(missing_cols) == 0, 
           paste0("Could not match the following required column(s): ", 
                  paste(missing_cols, collapse = ", "), 
                  ".\nFound columns: ", paste(names(df), collapse = ", ")))
    )
    
    # Convert numeric attributes in case they were read as strings
    df$top <- as.numeric(df$top)
    df$bottom <- as.numeric(df$bottom)
    df$Value <- as.numeric(df$Value)
    df$Chroma <- as.numeric(df$Chroma)
    df$Hue <- as.character(df$Hue)
    
    # Color convert Munsell to RGB
    df$color <- munsell2rgb(df$Hue, df$Value, df$Chroma)
    
    # Create combined label
    df$label <- paste(df$Profile, df$Horizon.Name, sep = " , ")
    
    # Convert to SoilProfileCollection object
    depths(df) <- Profile ~ top + bottom
    return(df)
  })
  
  output$profilePlot <- renderPlot({
    pedon <- pedon_data()
    if (!is.null(pedon)) {
      old_par <- par(no.readonly = TRUE)
      on.exit(par(old_par))
      
      par(mar = c(0.5, 0.5, 0.5, 0.5))
      
      plot(pedon,
           name = 'Horizon.Name',
           color = 'color',
           cex.names = 0.7,
           width = 0.3,
           depth.axis = FALSE,
           hz.depths = TRUE,
           fixLabelCollisions = TRUE,
           hz.depths.offset = 0.08)
    }
  },
  res = 96,
  width = function() input$plotWidth,
  height = function() input$plotHeight
  )
}

# --- Run App ---
shinyApp(ui = ui, server = server)
