# --- Helper Function: Column Standardization ---
standardize_columns <- function(df) {
  # Map standard internal target names to candidate patterns/regex
  column_patterns <- list(
    Profile      = "^(profile|id|pedon|pedon_id|profile_id|site)$",
    top          = "^(top|top_depth|hzdept|topdepth|depth_top|dept)$",
    bottom       = "^(bottom|bottom_depth|hzdepb|botdepth|depth_bottom|depb|bot)$",
    Hue          = "^(hue|munsell_hue|color_hue)$",
    Value        = "^(value|munsell_value|color_value|val)$",
    Chroma       = "^(chroma|munsell_chroma|color_chroma|chr)$",
    Horizon.Name = "^(horizon_name|horizonname|hzname|horizon|hz_name|name)$"
  )
  
  # Clean existing column names (lowercase, remove spaces/dots/underscores)
  cleaned_names <- tolower(gsub("[._ ]", "", names(df)))
  
  new_names <- names(df)
  
  for (target in names(column_patterns)) {
    pattern <- column_patterns[[target]]
    match_idx <- which(grepl(pattern, cleaned_names, ignore.case = TRUE))
    
    if (length(match_idx) > 0) {
      # Use the first matching column
      new_names[match_idx[1]] <- target
    }
  }
  
  names(df) <- new_names
  return(df)
}

